#!/usr/bin/env python3
"""Evidence trail for the coalescing layer's session-start check.

The run log's source_sha cues are the layer's retrieval contract, and
until this gate they were unchecked prose — the 2026-07-28 field audit
found cues that resolve locally but not in published history. This tool:

  1. verifies every `<sha>` cited in docs/coalescing.md resolves
     (`git cat-file -e`), here or in an identified sibling repository;
  2. verifies every `git show <sha>:<path>` cue's path exists at that
     SHA;
  3. checks each local SHA against the published remote (origin),
     reporting `local-only pin` where it does not resolve there — a cue
     that survives only on one machine is a claim the world cannot
     verify;
  4. derives the lessons-tier count with this repository's documented
     derivation so a session-start check can quote real numbers.

Adopted from agent-guidance @ e42762c via
`docs/plans/2026-07-28-agent-guidance-delta-wave-propagation-plan.md`.

Local adaptation — LESSONS DERIVATION. This repository's ledger uses
dated H2 sections in TWO shapes, and both are eligible material:

    ## 2026-07-01: Four-Way Implementation Bake-Off      (leading date)
    ## Specs: state contracts as rules, not examples (2026-07-03)

This tool implements the derivation command declared in
`docs/coalescing.md` (repaired 2026-07-28 to count both dated-H2
shapes; the prior leading-date-only form counted 1 of 22 sections —
the 2026-07-17 wave review's pre-existing owner item, closed by
repair-in-sweep). `docs/coalescing.md` remains the spec: when this
script and the declared commands disagree, the file wins and the
script is the defect.

Read-only by construction. Exit 1 only on an unresolvable local cue
(a broken retrieval contract); local-only pins and count reports are
informational — publication discipline is the owner's call.
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
STATE = REPO_ROOT / "docs" / "coalescing.md"

SHA_RE = re.compile(r"`([0-9a-f]{7,40})`")
CUE_RE = re.compile(r"git show ([0-9a-f]{7,40}):([A-Za-z0-9_./-]+)")

# Lessons ledger: dated H2 sections, either shape (see module docstring).
LESSON_LEADING_DATE = re.compile(r"^## 20[0-9]{2}-[0-9]{2}-[0-9]{2}", re.M)
LESSON_TRAILING_DATE = re.compile(r"^## .*\(20[0-9]{2}-[0-9]{2}-[0-9]{2}\)\s*$", re.M)

# This repo's cues cite the guidance hub as well as sibling consumers.
SIBLINGS = ["agent-theory", "mm", "weft", "taut", "engram", "simplebroker"]
SIBLING_ROOT = REPO_ROOT.parent


def git(*args: str, repo: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo or REPO_ROOT), *args],
                          capture_output=True, text=True)


def resolve_anywhere(sha: str) -> str | None:
    r"""A SHA claim is satisfied when it resolves in an identifiable repo:
    this one first, then each sibling. The state file's rows cite evidence
    across several repos in one cell (hub pins, sibling landings), so
    per-occurrence context attribution is unreliable; resolve-anywhere
    matches the actual cue contract (retrievable somewhere identified)."""
    if git("cat-file", "-e", f"{sha}^{{commit}}").returncode == 0:
        return "local"
    for name in SIBLINGS:
        cand = SIBLING_ROOT / name
        if (cand / ".git").exists():
            if git("cat-file", "-e", f"{sha}^{{commit}}", repo=cand).returncode == 0:
                return name
    return None


def main() -> int:
    if not STATE.is_file():
        print("coalesce-check: no docs/coalescing.md — nothing to check")
        return 0
    text = STATE.read_text()

    sha_hits = [(m.group(1), m.start()) for m in SHA_RE.finditer(text)]
    cues = sorted(set(CUE_RE.findall(text)))

    remote_ok = git("rev-parse", "--verify", "origin/HEAD").returncode == 0 or \
        git("rev-parse", "--verify", "origin/main").returncode == 0

    broken, local_only, sibling_ok = [], [], 0
    seen = set()
    for sha, _pos in sha_hits:
        if sha in seen:
            continue
        seen.add(sha)
        where = resolve_anywhere(sha)
        if where is None:
            broken.append(f"`{sha}` does not resolve locally or in any sibling")
        elif where != "local":
            sibling_ok += 1
        elif remote_ok:
            r = git("merge-base", "--is-ancestor", sha, "origin/main")
            if r.returncode != 0:
                local_only.append(sha)

    for sha, path in cues:
        # A cue may name a path in a sibling repo; resolve the SHA first.
        where = resolve_anywhere(sha)
        repo = REPO_ROOT if where in (None, "local") else SIBLING_ROOT / where
        if git("cat-file", "-e", f"{sha}:{path}", repo=repo).returncode != 0:
            broken.append(f"cue `git show {sha}:{path}` does not resolve")

    # Lessons-tier derivation (this repo's format: dated H2, both shapes).
    lessons = REPO_ROOT / "docs" / "lessons.md"
    leading = trailing = 0
    if lessons.is_file():
        ltext = lessons.read_text()
        leading = len(LESSON_LEADING_DATE.findall(ltext))
        trailing = len(LESSON_TRAILING_DATE.findall(ltext))

    print(f"coalesce-check: {len(seen)} SHA claim(s) ({sibling_ok} verified in "
          f"siblings), {len(cues)} retrieval cue(s); lessons dated H2 sections: "
          f"{leading + trailing} ({leading} leading-date, {trailing} trailing-date)")
    if local_only:
        print(f"  local-only pin ({len(local_only)}): " + ", ".join(local_only)
              + "  [not in origin/main — published history cannot verify these]")
    if broken:
        print(f"  BROKEN ({len(broken)}):")
        for b in broken:
            print(f"    {b}")
        return 1
    print("  all cues resolve"
          + ("" if remote_ok else "  [no origin remote — publication check skipped]"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
